{
  "name": "@aiwayds/dsh-subagent-registry",
  "version": "0.7.0",
  "description": "dsh plugin: register locally-defined custom agents (~/.dsh/agents/*.md) as callable subagents via the use_agent tool, with continuable background dispatch and ask_agent follow-ups",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subagent",
    "agent",
    "registry",
    "interactive",
    "background",
    "send-message",
    "resume",
    "persistence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-subagent-registry.git"
  },
  "homepage": "https://github.com/fan56/dsh-subagent-registry",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "link-closure": "node scripts/link-dsh-closure.mjs",
    "smoke": "node scripts/smoke-boot.mjs",
    "test": "node test/deep-semantics.test.mjs && node test/display-name.test.mjs && node test/resume.test.mjs && node test/thinking-level.test.mjs && node test/agent-options.test.mjs && node test/interactive.test.mjs && node test/apply-smoke.test.mjs && node test/seed-defaults.test.mjs && node test/profile-resolution.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  }
}
