# Podman install-integration image for the #2 packaging class.
#
# Proves what the local packaged-install unit test cannot: a REAL npm client
# inside a REAL container installs the PUBLISHED tarballs (dependency
# lifecycle scripts ON — the exact step that MODULE_NOT_FOUND'd for
# registry/cron/llm-proxy/profile-switch 0.12.0+), the closure linker stands
# down in the consumer tree, the real dsh host composes and boots each
# profile, and dcp's schema default survives the REAL host config
# materializer.
#
# Base scaffolding mirrors dsh-tui-pi's e2e/Containerfile.latest (DaoCloud
# base + npmmirror node dist for the DNS-poisoned podman VM; the plugin
# install itself uses the OFFICIAL registry — npmmirror may lag a fresh
# publish and the whole point of this image is testing what users install).
FROM docker.m.daocloud.io/library/ubuntu:24.04

ARG NODE_VERSION=22.23.2
ARG NODE_DIST_BASE=https://npmmirror.com/mirrors/node
ARG DSH_VERSION=

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils tmux git fd-find ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s "$(which fdfind)" /usr/local/bin/fd

RUN case "$(uname -m)" in \
      x86_64)  NODE_ARCH=x64 ;; \
      aarch64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL \
      "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && node --version

RUN test -n "${DSH_VERSION}" \
      || (echo "DSH_VERSION build arg is required" >&2; exit 1) \
 && npm install -g --no-fund --no-audit "@deepseek-ai/dsh@${DSH_VERSION}" \
 && dsh --version

WORKDIR /work
CMD ["bash", "/e2e/entry.sh"]
